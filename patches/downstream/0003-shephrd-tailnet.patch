diff --git a/shephrd/tailnet/serve_test.go b/shephrd/tailnet/serve_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..219453103e0226786d781941e4e7c914aee6ccc6
--- /dev/null
+++ b/shephrd/tailnet/serve_test.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// pair returns both ends of a Unix socketpair of kind as connections.
+func pair(t *testing.T, kind int) (net.Conn, net.Conn) {
+	t.Helper()
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, kind, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var conns [2]net.Conn
+	for i, fd := range fds {
+		file := os.NewFile(uintptr(fd), "pair")
+		conn, err := net.FileConn(file)
+		file.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { conn.Close() })
+		conns[i] = conn
+	}
+	return conns[0], conns[1]
+}
+
+// nextEvent reads one framed event from the core's end.
+func nextEvent(t *testing.T, conn net.Conn) *pb.Event {
+	t.Helper()
+	conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+	var header [4]byte
+	if _, err := io.ReadFull(conn, header[:]); err != nil {
+		t.Fatal(err)
+	}
+	body := make([]byte, binary.LittleEndian.Uint32(header[:]))
+	if _, err := io.ReadFull(conn, body); err != nil {
+		t.Fatal(err)
+	}
+	event := new(pb.Event)
+	if err := proto.Unmarshal(body, event); err != nil {
+		t.Fatal(err)
+	}
+	return event
+}
+
+// TestASignalRightAfterTheHelloIsForwarded sends SIGTERM to this process the
+// moment the hello arrives, as a supervisor may stop a core right after its
+// ready line: the package's handler must already be installed, or the signal
+// would end the test process, and the hello stays the first event.
+func TestASignalRightAfterTheHelloIsForwarded(t *testing.T) {
+	core, control := pair(t, syscall.SOCK_STREAM)
+	_, conns := pair(t, syscall.SOCK_DGRAM)
+	go serve(newCore(control, conns.(*net.UnixConn)))
+
+	if nextEvent(t, core).GetHello() == nil {
+		t.Fatal("the first event is not the hello")
+	}
+	if err := syscall.Kill(os.Getpid(), syscall.SIGTERM); err != nil {
+		t.Fatal(err)
+	}
+	signal := nextEvent(t, core).GetSignal()
+	if signal.GetKind() != pb.SignalKind_SIGNAL_KIND_TERM {
+		t.Fatalf("the event after the hello is not SIGTERM: %v", signal)
+	}
+}
diff --git a/shephrd/tailnet/sock_darwin.go b/shephrd/tailnet/sock_darwin.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a37994d8e8b37299c0ec44d8297764b06ebc8b2
--- /dev/null
+++ b/shephrd/tailnet/sock_darwin.go
@@ -0,0 +1,17 @@
+package main
+
+import "syscall"
+
+// socketpair creates the pair under ForkLock and marks both ends
+// close-on-exec, since macOS has no SOCK_CLOEXEC; a fork from a thread that
+// Go does not know of can still copy them in between.
+func socketpair() ([2]int, error) {
+	syscall.ForkLock.RLock()
+	defer syscall.ForkLock.RUnlock()
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err == nil {
+		syscall.CloseOnExec(fds[0])
+		syscall.CloseOnExec(fds[1])
+	}
+	return fds, err
+}
diff --git a/shephrd/tailnet/sock_linux.go b/shephrd/tailnet/sock_linux.go
