@@ -0,0 +1,244 @@
+// The messages between shephrdd and its tailnet package, version 1.
+//
+// They travel on the control socketpair in frames: a 4-byte little-endian
+// body length, then one Command (core to package) or Event (package to
+// core). The rules in shephrd/tailnet/README.md apply: additions only within
+// v1, fields in number order, no map fields, an UNSPECIFIED zero value in
+// every enum, reserved numbers for removed fields, and a comment on every
+// element.
+syntax = "proto3";
+
+package shephrd.tailnet.v1;
+
+option go_package = "tailscale.com/shephrd/tailnet/tailnetpb";
+
+// Every message the core sends to the package.
+message Command {
+  // The command; an arm the package does not know is ignored.
+  oneof body {
+    // Starts the node.
+    Up up = 1;
+    // Stops the node and keeps its state.
+    Down down = 2;
+    // Asks the control server for a new sign-in link.
+    Login login = 3;
+    // Signs the node out and forgets its identity.
+    Logout logout = 4;
+    // Opens a connection to another node.
+    Dial dial = 5;
+    // Asks for the package's counts, which a stats event answers.
+    ReadStats read_stats = 6;
+    // Says the core holds a handed connection's descriptor.
+    Taken taken = 7;
+  }
+}
+
+// Every message the package sends to the core.
+message Event {
+  // The event; an arm the core does not know is ignored.
+  oneof body {
+    // The package's first message.
+    Hello hello = 1;
+    // The node listens on the core's port.
+    Ready ready = 2;
+    // The node's state after a change.
+    State state = 3;
+    // A connection arrived; its descriptor travels on the connections socket.
+    Caller caller = 4;
+    // A dial connected; its descriptor travels on the connections socket.
+    Dialed dialed = 5;
+    // A dial failed.
+    DialFailed dial_failed = 6;
+    // Peers of the tailnet changed.
+    PeersChanged peers_changed = 7;
+    // The process received a signal the package owns.
+    Signal signal = 8;
+    // The package's counts, answering a read stats.
+    Stats stats = 9;
+  }
+}
+
+// The package's first message on the control socket.
+message Hello {
+  // The C interface's version, which the core compares with its own.
+  uint32 abi = 1;
+  // The package's build: its source tree hash and Tailscale's version.
+  string build = 2;
+}
+
+// Starts the node, signing in with the stored identity, with the auth key, or
+// by the link a NEEDS_LOGIN state carries. On a running node it changes
+// nothing and answers ready again: a new port or hostname takes a down first.
+message Up {
+  // The directory that holds the node's state, created mode 0700 by the core.
+  string state_dir = 1;
+  // The device name.
+  string hostname = 2;
+  // A key that signs the node in without a link; the package never stores or
+  // logs it.
+  optional string auth_key = 3;
+  // The control server's URL; empty means Tailscale's.
+  string control_url = 4;
+  // The TCP port the node accepts the core's callers on.
+  uint32 port = 5;
+  // Sets the node's identity aside first, so it signs in as a new device; a
+  // running node stops first. Without it, a state directory whose node record
+  // outlived its state fails rather than sign in afresh.
+  bool new_identity = 6;
+}
+
+// Stops the node; its state stays for the next up.
+message Down {}
+
+// Asks the control server for a new sign-in link, for a node that needs one.
+message Login {}
+
+// Signs the node out at the control server and deletes its state.
+message Logout {}
+
+// Opens a TCP connection to a node of the tailnet.
+message Dial {
+  // Chosen by the core, unique among its dials in flight, with the top bit
+  // set, which a caller's id never has, so the two share the connections
+  // socket; the answer and the descriptor carry it. A dial whose id lacks the
+  // bit fails.
+  uint64 id = 1;
+  // The node's MagicDNS name or tailnet address.
+  string host = 2;
+  // The TCP port.
+  uint32 port = 3;
+}
+
+// Asks for the package's counts.
+message ReadStats {}
+
+// The core took connection `id` off the connections socket, with its
+// descriptor or without it, so the package closes its own copy. Until then the
+// package keeps that copy open: on macOS a socket in flight can break when its
+// sender closes the last other copy before the receiver reads it.
+message Taken {
+  // The connection's id, a caller's or a dial's.
+  uint64 id = 1;
+}
+
+// The node listens on the port the last up named.
+message Ready {}
+
+// The state of the node.
+enum NodeState {
+  // Not set.
+  NODE_STATE_UNSPECIFIED = 0;
+  // No node runs.
+  NODE_STATE_STOPPED = 1;
+  // The node is starting or reconnecting to the control server.
+  NODE_STATE_STARTING = 2;
+  // The node waits for a sign-in by the login link.
+  NODE_STATE_NEEDS_LOGIN = 3;
+  // The node is on the tailnet.
+  NODE_STATE_RUNNING = 4;
+  // The node stopped on an error it cannot recover from alone.
+  NODE_STATE_FAILED = 5;
+}
+
+// The node's state after a change.
+message State {
+  // The state.
+  NodeState state = 1;
+  // The sign-in link, while the state is NEEDS_LOGIN.
+  string login_url = 2;
+  // The node's MagicDNS name, once the control server has named it.
+  string name = 3;
+  // The node's tailnet addresses, while it runs.
+  repeated string addresses = 4;
+  // Why the state is FAILED, or a health warning in another state.
+  string error = 5;
+}
+
+// Who a connection came from, as WhoIs reports it.
+message Caller {
+  // The connection's id, which its descriptor carries on the connections
+  // socket. It never has the top bit set, which marks a dial's id.
+  uint64 id = 1;
+  // The caller's identity.
+  Peer peer = 2;
+}
+
+// A node of the tailnet and the user who owns it.
+message Peer {
+  // The node's stable id.
+  string stable_id = 1;
+  // The node's MagicDNS name.
+  string node_name = 2;
+  // The owning user's id; for a tagged node, the id Tailscale gives tagged
+  // devices.
+  uint64 user_id = 3;
+  // The owning user's login name.
+  string login_name = 4;
+  // The node's ACL tags; empty for a user-owned node.
+  repeated string tags = 5;
+  // The node is shared in from another tailnet.
+  bool shared = 6;
+  // In a peers-changed event: the node left the tailnet.
+  bool removed = 7;
+}
+
+// A dial connected.
+message Dialed {
+  // The dial's id, which the descriptor carries on the connections socket.
+  uint64 id = 1;
+  // The remote node's tailnet address the connection reached.
+  string address = 2;
+}
+
+// A dial failed.
+message DialFailed {
+  // The dial's id.
+  uint64 id = 1;
+  // Why.
+  string error = 2;
+}
+
+// Peers of the tailnet changed: each one that changed or left.
+message PeersChanged {
+  // The peers, as they are now.
+  repeated Peer peers = 1;
+}
+
+// A signal the package owns.
+enum SignalKind {
+  // Not set.
+  SIGNAL_KIND_UNSPECIFIED = 0;
+  // SIGTERM.
+  SIGNAL_KIND_TERM = 1;
+  // SIGINT.
+  SIGNAL_KIND_INT = 2;
+}
+
+// The process received a signal; the core shuts down as it would on Stop.
+message Signal {
+  // Which signal.
+  SignalKind kind = 1;
+}
+
+// The node record the package keeps as node.pb in the state directory, mode
+// 0600, once the node has run. It says the directory held a signed-in node,
+// so a state that went missing fails the next up rather than sign in afresh;
+// the core never reads it.
+message NodeRecord {
+  // The node's stable id.
+  string stable_id = 1;
+  // The node's MagicDNS name.
+  string name = 2;
+  // The Tailscale version that last ran the node; a state from a newer one is
+  // refused, as tsnet has no downgrade path.
+  string tailscale_version = 3;
+}
+
+// The package's counts, for a core to log and its tests to bound.
+message Stats {
+  // The process's goroutines, Go's runtime.NumGoroutine.
+  uint32 goroutines = 1;
+  // The connections the package carries for the core: accepted and dialed,
+  // until both their directions end.
+  uint32 connections = 2;
+}
diff --git a/shephrd/tailnet/serve_test.go b/shephrd/tailnet/serve_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8b7ebc8801eef401f0371be9393ffba2f9658803
--- /dev/null
+++ b/shephrd/tailnet/serve_test.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// pair returns both ends of a Unix socketpair of kind as connections.
+func pair(t *testing.T, kind int) (net.Conn, net.Conn) {
+	t.Helper()
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, kind, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var conns [2]net.Conn
+	for i, fd := range fds {
+		file := os.NewFile(uintptr(fd), "pair")
+		conn, err := net.FileConn(file)
+		file.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { conn.Close() })
+		conns[i] = conn
+	}
+	return conns[0], conns[1]
+}
+
+// nextEvent reads one framed event from the core's end.
+func nextEvent(t *testing.T, conn net.Conn) *pb.Event {
+	t.Helper()
+	conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+	var header [4]byte
+	if _, err := io.ReadFull(conn, header[:]); err != nil {
+		t.Fatal(err)
+	}
+	body := make([]byte, binary.LittleEndian.Uint32(header[:]))
+	if _, err := io.ReadFull(conn, body); err != nil {
+		t.Fatal(err)
+	}
+	event := new(pb.Event)
+	if err := proto.Unmarshal(body, event); err != nil {
+		t.Fatal(err)
+	}
+	return event
+}
+
+// TestASignalRightAfterTheHelloIsForwarded sends SIGTERM to this process the
+// moment the hello arrives, as a supervisor may stop a core right after its
+// ready line: the package's handler must already be installed, or the signal
+// would end the test process, and the hello stays the first event.
+func TestASignalRightAfterTheHelloIsForwarded(t *testing.T) {
+	core, control := pair(t, syscall.SOCK_STREAM)
+	_, conns := pair(t, syscall.SOCK_STREAM)
+	go serve(newCore(control, conns.(*net.UnixConn)))
+
+	if nextEvent(t, core).GetHello() == nil {
+		t.Fatal("the first event is not the hello")
+	}
+	if err := syscall.Kill(os.Getpid(), syscall.SIGTERM); err != nil {
+		t.Fatal(err)
+	}
+	signal := nextEvent(t, core).GetSignal()
+	if signal.GetKind() != pb.SignalKind_SIGNAL_KIND_TERM {
+		t.Fatalf("the event after the hello is not SIGTERM: %v", signal)
+	}
+}
diff --git a/shephrd/tailnet/sock_darwin.go b/shephrd/tailnet/sock_darwin.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a37994d8e8b37299c0ec44d8297764b06ebc8b2
--- /dev/null
+++ b/shephrd/tailnet/sock_darwin.go
@@ -0,0 +1,17 @@
+package main
+
+import "syscall"
+
+// socketpair creates the pair under ForkLock and marks both ends
+// close-on-exec, since macOS has no SOCK_CLOEXEC; a fork from a thread that
+// Go does not know of can still copy them in between.
+func socketpair() ([2]int, error) {
+	syscall.ForkLock.RLock()
+	defer syscall.ForkLock.RUnlock()
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err == nil {
+		syscall.CloseOnExec(fds[0])
+		syscall.CloseOnExec(fds[1])
+	}
+	return fds, err
+}
diff --git a/shephrd/tailnet/sock_linux.go b/shephrd/tailnet/sock_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..4074fbd99a84ef898d0ac714a38bfdb25f34992b
--- /dev/null
+++ b/shephrd/tailnet/sock_linux.go
@@ -0,0 +1,8 @@
+package main
+
+import "syscall"
+
+// socketpair creates both ends close-on-exec atomically.
+func socketpair() ([2]int, error) {
+	return syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM|syscall.SOCK_CLOEXEC, 0)
+}
