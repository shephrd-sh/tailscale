diff --git a/shephrd/tailnet/README.md b/shephrd/tailnet/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..41ab645b81072c4992d0f578f19c64a28236c319
--- /dev/null
+++ b/shephrd/tailnet/README.md
@@ -0,0 +1,51 @@
+# libshephrdtailnet
+
+[shephrd](https://github.com/shephrd-sh)'s tailnet package, built with Go's `-buildmode=c-archive` into `libshephrdtailnet.a`, which the shephrd core daemon links.
+It runs the process's one tsnet node from the Tailscale tree beside it, with this fork's patches, and owns `SIGTERM` and `SIGINT`.
+It lives in the fork so it builds against exactly that tree, and a Tailscale upgrade rebases it with the rest of the stack.
+
+## The C interface
+
+Two functions, whose version is `abi` in `tailnet.go`:
+
+1. `shephrd_tailnet_abi()` returns the C interface's version, which the core checks before it calls anything else.
+2. `shephrd_tailnet_start(control, conns)` takes one end of a stream socketpair, which carries framed commands and events, and one end of a second stream socketpair, which carries each connection's 8-byte id with its descriptor attached to the id's first byte: a dial's id has the top bit set, and a caller's never does. A stream, unlike a datagram socket, makes the package wait while the core is behind, so no handover is lost; macOS drops a datagram sent to a full queue. The package keeps its own copy of each descriptor open until a `Taken` command names the id, since on macOS a socket in flight can break when its sender closes the last other copy before the receiver reads it.
+
+`abi` rises with every change to an exported function's name, signature or meaning.
+
+## The state directory
+
+`Up` names the node's state directory, which the core creates.
+tsnet keeps the node's identity there in `tailscaled.state`, and once the node has run, the package keeps `node.pb` beside it, mode `0600`: a `NodeRecord` with the node's stable id, name and the Tailscale version that ran it.
+Before tsnet reads the state, the package refuses to start, with a `FAILED` state, when the record outlived its state (missing or empty, which tsnet would replace with a new identity) or names a newer Tailscale than this build's, since tsnet has no downgrade path.
+`Up` with `new_identity` first moves the package's files, `tailscaled*`, `certs` and `node.pb`, into a `replaced-<time>` directory beside them; the core's own files stay.
+
+## The schema
+
+[`proto/shephrd/tailnet/v1/tailnet.proto`](proto/shephrd/tailnet/v1/tailnet.proto) defines the messages on the control socket: each frame is a 4-byte little-endian body length, then one `Command` from the core or one `Event` from the package.
+`tailnetpb/` holds the Go types generated from it, and `fixtures/v1/` one encoded message per file, which the Go tests and shephrd's binding both check.
+
+Rules for changing the schema:
+
+1. Change `v1` only by adding messages, arms and fields; anything else is a new version directory.
+2. Declare fields in field-number order, and use no `map` fields.
+3. Give every enum a zero value named `<ENUM>_UNSPECIFIED`.
+4. Mark a removed field or arm `reserved`, by number and name, and never reuse a number.
+5. Comment every message, field, arm and enum value.
+6. Add a fixture, with its value in `fixtures_test.go`, for each new message.
+7. Regenerate with `mise run tailnet:generate` and `mise run tailnet:fixtures`; `mise run tailnet:check` fails when the committed types differ from the schema.
+
+## Releases
+
+`.github/workflows/shephrd-tailnet.yml` releases each push to `downstream` that passes `mise run fork check`, the package's tests and the schema check.
+The release is `tailnet-<Tailscale version>-<commit>`, the first 12 characters of the `downstream` commit, so a push that changes nothing releases nothing new.
+
+Each `libshephrdtailnet-<version>-<target>.tar.gz`, for `linux-x64` and `macos-arm64`, holds:
+
+- `lib/libshephrdtailnet.a` and `include/libshephrdtailnet.h`, built with Go from `mise.toml`, `CGO_ENABLED=1`, `-trimpath` and `-tags ts_omit_logtail`, so the archive holds no log uploader; macOS builds for macOS 26.0.
+- `bin/testcontrol`, `shephrd/testcontrol` from the same commit: Tailscale's test control server with its DERP and STUN servers, for the core's tests, with flags for a required sign-in and an auth key, and an admin API on loopback only that completes a sign-in, tags a node, expires keys and sends `Debug.Exit`. It is test-only and never ships in an app.
+- `proto/` and `fixtures/`, the schema and fixtures above.
+- `COMMIT`, the full commit the archive was built from, which shephrd's binding checks against the version it pins.
+- `LICENSE`, Tailscale's BSD-3-Clause license.
+
+Each archive has a `.sha256` beside it.
diff --git a/shephrd/tailnet/conns.go b/shephrd/tailnet/conns.go
new file mode 100644
index 0000000000000000000000000000000000000000..e835b911f3ef0e99f77376e4fdaad8848324c349
--- /dev/null
+++ b/shephrd/tailnet/conns.go
@@ -0,0 +1,62 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"syscall"
+)
+
+// pumping counts the connections pump carries, for the stats event.
+var pumping atomic.Int64
+
+// pump returns the core's end of a close-on-exec socketpair whose other end
+// carries conn, and closes both when either direction ends. The package's end
+// lives only in the goroutines that copy it, so nothing keys a connection by
+// its descriptor number (design, decision 2).
+func pump(conn net.Conn) (int, error) {
+	fds, err := socketpair()
+	if err != nil {
+		return -1, err
+	}
+	// Non-blocking, so os.NewFile puts the copies on Go's poller instead of a
+	// thread blocked in read(2) per connection. The core's end stays
+	// blocking; the binding sets its own mode.
+	if err := syscall.SetNonblock(fds[1], true); err != nil {
+		syscall.Close(fds[0])
+		syscall.Close(fds[1])
+		return -1, err
+	}
+	ours := os.NewFile(uintptr(fds[1]), "tailnet-conn")
+	pumping.Add(1)
+	var both sync.WaitGroup
+	both.Add(2)
+	go func() {
+		defer both.Done()
+		if _, err := io.Copy(ours, conn); err != nil {
+			fmt.Fprintf(os.Stderr, "tailnet: connection from %v ended: %v\n", conn.RemoteAddr(), err)
+		}
+		// The peer finished sending: tell the core, which still reads.
+		syscall.Shutdown(fds[1], syscall.SHUT_WR)
+	}()
+	go func() {
+		defer both.Done()
+		if _, err := io.Copy(conn, ours); err != nil {
+			fmt.Fprintf(os.Stderr, "tailnet: connection to %v ended: %v\n", conn.RemoteAddr(), err)
+		}
+		// The core never half-closes a connection it still reads, so its end
+		// finishing ends the connection: closing conn also stops the copy
+		// above, even when the peer is idle.
+		conn.Close()
+	}()
+	go func() {
+		both.Wait()
+		ours.Close()
+		conn.Close()
+		pumping.Add(-1)
+	}()
+	return fds[0], nil
+}
diff --git a/shephrd/tailnet/core.go b/shephrd/tailnet/core.go
new file mode 100644
index 0000000000000000000000000000000000000000..158e64a8bcd77512a71311e7b3ca0a90714ca77c
--- /dev/null
+++ b/shephrd/tailnet/core.go
@@ -0,0 +1,168 @@
+package main
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/signal"
+	"sync"
+	"syscall"
+
+	"google.golang.org/protobuf/proto"
+	"tailscale.com/version"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// maxFrame bounds a command's body; the largest, an up, is a few hundred
+// bytes.
+const maxFrame = 64 << 10
+
+// core is the package's side of the two sockets.
+type core struct {
+	control net.Conn
+	conns   *net.UnixConn
+
+	// mu orders whole frames on the control socket.
+	mu sync.Mutex
+	// fdMu keeps each id whole on the connections stream.
+	fdMu sync.Mutex
+	// held keeps the package's copy of each handed descriptor, by
+	// connection id, until the core takes it.
+	heldMu sync.Mutex
+	held   map[uint64]int
+}
+
+func newCore(control net.Conn, conns *net.UnixConn) *core {
+	return &core{control: control, conns: conns, held: map[uint64]int{}}
+}
+
+// send writes one event as a frame: a 4-byte little-endian length, then the
+// body. A write error means the core is gone, and the read loop ends too.
+func (c *core) send(event *pb.Event) {
+	body, err := proto.Marshal(event)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "tailnet: encode event: %v\n", err)
+		return
+	}
+	frame := binary.LittleEndian.AppendUint32(make([]byte, 0, 4+len(body)), uint32(len(body)))
+	frame = append(frame, body...)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if _, err := c.control.Write(frame); err != nil {
+		c.control.Close()
+	}
+}
+
+// sendFd hands the core a connection's descriptor on the connections stream,
+// as its 8-byte id with the descriptor attached to the id's first byte. A
+// full stream waits for the core to read, so a burst of connections is never
+// dropped, as a datagram socket drops them on macOS; an error means the core
+// is gone, and the descriptor is closed.
+//
+// The package's copy stays open until the core's taken command names the id:
+// on macOS a socket in flight can break when its sender closes the last other
+// copy before the receiver reads it. It is held before the write, since the
+// core can take the id before the write returns.
+func (c *core) sendFd(id uint64, fd int) error {
+	c.heldMu.Lock()
+	c.held[id] = fd
+	c.heldMu.Unlock()
+	if err := c.writeFd(id, fd); err != nil {
+		c.taken(id)
+		return err
+	}
+	return nil
+}
+
+func (c *core) writeFd(id uint64, fd int) error {
+	body := binary.LittleEndian.AppendUint64(nil, id)
+	c.fdMu.Lock()
+	defer c.fdMu.Unlock()
+	n, _, err := c.conns.WriteMsgUnix(body, syscall.UnixRights(fd), nil)
+	if err != nil {
+		return err
+	}
+	// The descriptor went with the first byte; the rest of the id follows.
+	_, err = c.conns.Write(body[n:])
+	return err
+}
+
+// taken closes the package's copy of connection id's descriptor; an id the
+// package does not hold changes nothing.
+func (c *core) taken(id uint64) {
+	c.heldMu.Lock()
+	fd, ok := c.held[id]
+	delete(c.held, id)
+	c.heldMu.Unlock()
+	if ok {
+		syscall.Close(fd)
+	}
+}
+
+// read returns the next command, or io.EOF when the core closed the socket.
+func (c *core) read() (*pb.Command, error) {
+	var header [4]byte
+	if _, err := io.ReadFull(c.control, header[:]); err != nil {
+		return nil, err
+	}
+	n := binary.LittleEndian.Uint32(header[:])
+	if n > maxFrame {
+		return nil, fmt.Errorf("a command of %d bytes exceeds %d", n, maxFrame)
+	}
+	body := make([]byte, n)
+	if _, err := io.ReadFull(c.control, body); err != nil {
+		return nil, err
+	}
+	command := new(pb.Command)
+	if err := proto.Unmarshal(body, command); err != nil {
+		return nil, err
+	}
+	return command, nil
+}
+
+// serve owns SIGTERM and SIGINT, sends the hello, and carries out commands
+// until the control socket closes; then it stops the node.
+func serve(c *core) {
+	// The handlers are installed before the hello: the core starts the
+	// package before it says it is ready, so a stop signal sent right after
+	// that line is caught. Forwarding starts after the hello, which stays the
+	// first event; a signal in between waits in the channel.
+	signals := make(chan os.Signal, 1)
+	signal.Notify(signals, syscall.SIGTERM, syscall.SIGINT)
+	defer signal.Stop(signals)
+	c.send(&pb.Event{Body: &pb.Event_Hello{Hello: &pb.Hello{
+		Abi:   abi,
+		Build: fmt.Sprintf("tailnet %s tailscale %s", commit, version.Short()),
+	}}})
+	go forwardSignals(c, signals)
+	// The node's own goroutine carries the commands out, so a command that
+	// waits never holds up reading the next.
+	commands := make(chan *pb.Command)
+	go func() {
+		defer close(commands)
+		for {
+			command, err := c.read()
+			if err != nil {
+				if err != io.EOF {
+					fmt.Fprintf(os.Stderr, "tailnet: control socket: %v\n", err)
+				}
+				return
+			}
+			commands <- command
+		}
+	}()
+	newNode(c).run(commands)
+}
+
+func forwardSignals(c *core, signals <-chan os.Signal) {
+	for s := range signals {
+		kind := pb.SignalKind_SIGNAL_KIND_TERM
+		if s == syscall.SIGINT {
+			kind = pb.SignalKind_SIGNAL_KIND_INT
+		}
+		c.send(&pb.Event{Body: &pb.Event_Signal{Signal: &pb.Signal{Kind: kind}}})
+	}
+}
diff --git a/shephrd/tailnet/core_test.go b/shephrd/tailnet/core_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e963cee8ed8b574a0f8a44fe7637f26e3ff50ea0
--- /dev/null
+++ b/shephrd/tailnet/core_test.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// TestABurstOfHandoversWaitsForTheCore hands over more connections than the
+// connections stream holds while the core does not read: every one arrives
+// whole and in order once it reads. A datagram socket on macOS drops them
+// when its 4 KiB queue fills.
+func TestABurstOfHandoversWaitsForTheCore(t *testing.T) {
+	coreEnd, ours := pair(t, syscall.SOCK_STREAM)
+	c := newCore(nil, ours.(*net.UnixConn))
+	const burst = 200
+	sent := make(chan error, 1)
+	go func() {
+		for id := uint64(1); id <= burst; id++ {
+			fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+			if err != nil {
+				sent <- err
+				return
+			}
+			syscall.Close(fds[1])
+			if err := c.sendFd(id, fds[0]); err != nil {
+				sent <- err
+				return
+			}
+		}
+		sent <- nil
+	}()
+	// The reader holds back long enough for the stream to fill.
+	time.Sleep(500 * time.Millisecond)
+
+	reader := coreEnd.(*net.UnixConn)
+	reader.SetReadDeadline(time.Now().Add(10 * time.Second))
+	var record [8]byte
+	filled, ids, fds := 0, uint64(0), 0
+	oob := make([]byte, syscall.CmsgSpace(4*4))
+	for ids < burst {
+		n, oobn, _, _, err := reader.ReadMsgUnix(record[filled:], oob)
+		if err != nil {
+			t.Fatalf("after %d ids: %v", ids, err)
+		}
+		messages, err := syscall.ParseSocketControlMessage(oob[:oobn])
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, message := range messages {
+			rights, err := syscall.ParseUnixRights(&message)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, fd := range rights {
+				syscall.Close(fd)
+			}
+			fds += len(rights)
+		}
+		filled += n
+		if filled < len(record) {
+			continue
+		}
+		filled = 0
+		ids++
+		if got := binary.LittleEndian.Uint64(record[:]); got != ids {
+			t.Fatalf("id %d arrived as id %d", ids, got)
+		}
+	}
+	if fds != burst {
+		t.Fatalf("%d descriptors arrived with %d ids", fds, burst)
+	}
+	if err := <-sent; err != nil {
+		t.Fatal(err)
+	}
+	if len(c.held) != burst {
+		t.Fatalf("the package holds %d descriptors, not %d", len(c.held), burst)
+	}
+	for id := uint64(1); id <= burst; id++ {
+		c.taken(id)
+	}
+	if len(c.held) != 0 {
+		t.Fatalf("the package still holds %d descriptors once all are taken", len(c.held))
+	}
+}
+
+// TestAHandedDescriptorStaysOpenUntilTaken closes the core's copy at once: the
+// connection stays open through the package's copy until the core takes it.
+func TestAHandedDescriptorStaysOpenUntilTaken(t *testing.T) {
+	coreEnd, ours := pair(t, syscall.SOCK_STREAM)
+	c := newCore(nil, ours.(*net.UnixConn))
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peerFile := os.NewFile(uintptr(fds[1]), "peer")
+	peer, err := net.FileConn(peerFile)
+	peerFile.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	if err := c.sendFd(5, fds[0]); err != nil {
+		t.Fatal(err)
+	}
+	reader := coreEnd.(*net.UnixConn)
+	reader.SetReadDeadline(time.Now().Add(10 * time.Second))
+	var record [8]byte
+	oob := make([]byte, syscall.CmsgSpace(4))
+	if _, oobn, _, _, err := reader.ReadMsgUnix(record[:], oob); err != nil {
+		t.Fatal(err)
+	} else {
+		messages, err := syscall.ParseSocketControlMessage(oob[:oobn])
+		if err != nil || len(messages) != 1 {
+			t.Fatalf("%d control messages: %v", len(messages), err)
+		}
+		rights, err := syscall.ParseUnixRights(&messages[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, fd := range rights {
+			syscall.Close(fd)
+		}
+	}
+
+	var one [1]byte
+	peer.SetReadDeadline(time.Now().Add(200 * time.Millisecond))
+	if _, err := peer.Read(one[:]); !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatalf("the connection ended before the core took it: %v", err)
+	}
+	c.taken(5)
+	peer.SetReadDeadline(time.Now().Add(10 * time.Second))
+	if _, err := peer.Read(one[:]); err != io.EOF {
+		t.Fatalf("the connection stayed open once taken: %v", err)
+	}
+}
