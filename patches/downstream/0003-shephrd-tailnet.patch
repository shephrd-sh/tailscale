new file mode 100644
index 0000000000000000000000000000000000000000..b9f46a564daf734ea90767e9e2d102b085d77757
--- /dev/null
+++ b/shephrd/tailnet/README.md
@@ -0,0 +1,44 @@
+# libshephrdtailnet
+
+[shephrd](https://github.com/shephrd-sh)'s tailnet package, built with Go's `-buildmode=c-archive` into `libshephrdtailnet.a`, which the shephrd core daemon links.
+It runs the process's one tsnet node from the Tailscale tree beside it, with this fork's patches, and owns `SIGTERM` and `SIGINT`.
+It lives in the fork so it builds against exactly that tree, and a Tailscale upgrade rebases it with the rest of the stack.
+
+## The C interface
+
+Two functions, whose version is `abi` in `tailnet.go`:
+
+1. `shephrd_tailnet_abi()` returns the C interface's version, which the core checks before it calls anything else.
+2. `shephrd_tailnet_start(control, conns)` takes one end of a stream socketpair, which carries framed commands and events, and one end of a datagram socketpair, which carries each connection's descriptor with its 8-byte id.
+
+`abi` rises with every change to an exported function's name, signature or meaning.
+
+## The schema
+
+[`proto/shephrd/tailnet/v1/tailnet.proto`](proto/shephrd/tailnet/v1/tailnet.proto) defines the messages on the control socket: each frame is a 4-byte little-endian body length, then one `Command` from the core or one `Event` from the package.
+`tailnetpb/` holds the Go types generated from it, and `fixtures/v1/` one encoded message per file, which the Go tests and shephrd's binding both check.
+
+Rules for changing the schema:
+
+1. Change `v1` only by adding messages, arms and fields; anything else is a new version directory.
+2. Declare fields in field-number order, and use no `map` fields.
+3. Give every enum a zero value named `<ENUM>_UNSPECIFIED`.
+4. Mark a removed field or arm `reserved`, by number and name, and never reuse a number.
+5. Comment every message, field, arm and enum value.
+6. Add a fixture, with its value in `fixtures_test.go`, for each new message.
+7. Regenerate with `mise run tailnet:generate` and `mise run tailnet:fixtures`; `mise run tailnet:check` fails when the committed types differ from the schema.
+
+## Releases
+
+`.github/workflows/shephrd-tailnet.yml` releases each push to `downstream` that passes `mise run fork check`, the package's tests and the schema check.
+The release is `tailnet-<Tailscale version>-<commit>`, the first 12 characters of the `downstream` commit, so a push that changes nothing releases nothing new.
+
+Each `libshephrdtailnet-<version>-<target>.tar.gz`, for `linux-x64` and `macos-arm64`, holds:
+
+- `lib/libshephrdtailnet.a` and `include/libshephrdtailnet.h`, built with Go from `mise.toml`, `CGO_ENABLED=1`, `-trimpath` and `-tags ts_omit_logtail`, so the archive holds no log uploader; macOS builds for macOS 26.0.
+- `bin/testcontrol`, Tailscale's `cmd/testcontrol` from the same commit, a test control server for the core's tests; it never ships in an app.
+- `proto/` and `fixtures/`, the schema and fixtures above.
+- `COMMIT`, the full commit the archive was built from, which shephrd's binding checks against the version it pins.
+- `LICENSE`, Tailscale's BSD-3-Clause license.
+
+Each archive has a `.sha256` beside it.
diff --git a/shephrd/tailnet/conns.go b/shephrd/tailnet/conns.go
new file mode 100644
index 0000000000000000000000000000000000000000..f268b49e8e8cd28eaa523499a0ca36a389a557de
--- /dev/null
+++ b/shephrd/tailnet/conns.go
@@ -0,0 +1,51 @@
+package main
+
+import (
+	"io"
+	"net"
+	"os"
+	"sync"
+	"syscall"
+)
+
+// pump returns the core's end of a close-on-exec socketpair whose other end
+// carries conn, and closes both when either direction ends. The package's end
+// lives only in the goroutines that copy it, so nothing keys a connection by
+// its descriptor number (design, decision 2).
+func pump(conn net.Conn) (int, error) {
+	fds, err := socketpair()
+	if err != nil {
+		return -1, err
+	}
+	// Non-blocking, so os.NewFile puts the copies on Go's poller instead of a
+	// thread blocked in read(2) per connection. The core's end stays
+	// blocking; the binding sets its own mode.
+	if err := syscall.SetNonblock(fds[1], true); err != nil {
+		syscall.Close(fds[0])
+		syscall.Close(fds[1])
+		return -1, err
+	}
+	ours := os.NewFile(uintptr(fds[1]), "tailnet-conn")
+	var both sync.WaitGroup
+	both.Add(2)
+	go func() {
+		defer both.Done()
+		io.Copy(ours, conn)
+		// The peer finished sending: tell the core, which still reads.
+		syscall.Shutdown(fds[1], syscall.SHUT_WR)
+	}()
+	go func() {
+		defer both.Done()
+		io.Copy(conn, ours)
+		// The core never half-closes a connection it still reads, so its end
+		// finishing ends the connection: closing conn also stops the copy
+		// above, even when the peer is idle.
+		conn.Close()
+	}()
+	go func() {
+		both.Wait()
+		ours.Close()
+		conn.Close()
+	}()
+	return fds[0], nil
+}
diff --git a/shephrd/tailnet/core.go b/shephrd/tailnet/core.go
new file mode 100644
index 0000000000000000000000000000000000000000..a711f1c671f82b14c40076017d7e0496cd608ed8
--- /dev/null
+++ b/shephrd/tailnet/core.go
@@ -0,0 +1,128 @@
+package main
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/signal"
+	"sync"
+	"syscall"
+
+	"google.golang.org/protobuf/proto"
+	"tailscale.com/version"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// maxFrame bounds a command's body; the largest, an up, is a few hundred
+// bytes.
+const maxFrame = 64 << 10
+
+// core is the package's side of the two sockets.
+type core struct {
+	control net.Conn
+	conns   *net.UnixConn
+
+	// mu orders whole frames on the control socket and descriptors on the
+	// connections socket.
+	mu sync.Mutex
+}
+
+func newCore(control net.Conn, conns *net.UnixConn) *core {
+	return &core{control: control, conns: conns}
+}
+
+// send writes one event as a frame: a 4-byte little-endian length, then the
+// body. A write error means the core is gone, and the read loop ends too.
+func (c *core) send(event *pb.Event) {
+	body, err := proto.Marshal(event)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "tailnet: encode event: %v\n", err)
+		return
+	}
+	frame := binary.LittleEndian.AppendUint32(make([]byte, 0, 4+len(body)), uint32(len(body)))
+	frame = append(frame, body...)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if _, err := c.control.Write(frame); err != nil {
+		c.control.Close()
+	}
+}
+
+// sendFd hands the core a connection's descriptor, with its 8-byte id as the
+// datagram's body, then closes the package's copy.
+func (c *core) sendFd(id uint64, fd int) error {
+	defer syscall.Close(fd)
+	body := binary.LittleEndian.AppendUint64(nil, id)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	_, _, err := c.conns.WriteMsgUnix(body, syscall.UnixRights(fd), nil)
+	return err
+}
+
+// read returns the next command, or io.EOF when the core closed the socket.
+func (c *core) read() (*pb.Command, error) {
+	var header [4]byte
+	if _, err := io.ReadFull(c.control, header[:]); err != nil {
+		return nil, err
+	}
+	n := binary.LittleEndian.Uint32(header[:])
+	if n > maxFrame {
+		return nil, fmt.Errorf("a command of %d bytes exceeds %d", n, maxFrame)
+	}
+	body := make([]byte, n)
+	if _, err := io.ReadFull(c.control, body); err != nil {
+		return nil, err
+	}
+	command := new(pb.Command)
+	if err := proto.Unmarshal(body, command); err != nil {
+		return nil, err
+	}
+	return command, nil
+}
+
+// serve owns SIGTERM and SIGINT, sends the hello, and carries out commands
+// until the control socket closes; then it stops the node.
+func serve(c *core) {
+	// The handlers are installed before the hello: the core starts the
+	// package before it says it is ready, so a stop signal sent right after
+	// that line is caught. Forwarding starts after the hello, which stays the
+	// first event; a signal in between waits in the channel.
+	signals := make(chan os.Signal, 1)
+	signal.Notify(signals, syscall.SIGTERM, syscall.SIGINT)
+	defer signal.Stop(signals)
+	c.send(&pb.Event{Body: &pb.Event_Hello{Hello: &pb.Hello{
+		Abi:   abi,
+		Build: fmt.Sprintf("tailnet %s tailscale %s", commit, version.Short()),
+	}}})
+	go forwardSignals(c, signals)
+	// The node's own goroutine carries the commands out, so a command that
+	// waits never holds up reading the next.
+	commands := make(chan *pb.Command)
+	go func() {
+		defer close(commands)
+		for {
+			command, err := c.read()
+			if err != nil {
+				if err != io.EOF {
+					fmt.Fprintf(os.Stderr, "tailnet: control socket: %v\n", err)
+				}
+				return
+			}
+			commands <- command
+		}
+	}()
+	newNode(c).run(commands)
+}
+
+func forwardSignals(c *core, signals <-chan os.Signal) {
+	for s := range signals {
+		kind := pb.SignalKind_SIGNAL_KIND_TERM
+		if s == syscall.SIGINT {
+			kind = pb.SignalKind_SIGNAL_KIND_INT
+		}
+		c.send(&pb.Event{Body: &pb.Event_Signal{Signal: &pb.Signal{Kind: kind}}})
+	}
+}
