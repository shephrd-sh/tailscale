@@ -0,0 +1,24 @@
+package main
+
+import (
+	"testing"
+
+	"tailscale.com/health"
+)
+
+// TestHealthTextJoinsTheWarningsInOrder checks that every warning's text
+// reaches the state's error, in a stable order, and that none gives "".
+func TestHealthTextJoinsTheWarningsInOrder(t *testing.T) {
+	state := &health.State{Warnings: map[health.WarnableCode]health.UnhealthyState{
+		"network-status": {Text: "Tailscale cannot connect because the network is down."},
+		"login-state":    {Text: "You are logged out. The last login error was: connection refused"},
+		"empty":          {},
+	}}
+	want := "You are logged out. The last login error was: connection refused; Tailscale cannot connect because the network is down."
+	if got := healthText(state); got != want {
+		t.Errorf("healthText = %q, want %q", got, want)
+	}
+	if got := healthText(&health.State{}); got != "" {
+		t.Errorf("no warning gave %q", got)
+	}
+}
diff --git a/shephrd/tailnet/identity.go b/shephrd/tailnet/identity.go
new file mode 100644
index 0000000000000000000000000000000000000000..014f79e466fd9970a66872a8fc6d220789ee1a1a
--- /dev/null
+++ b/shephrd/tailnet/identity.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+	"tailscale.com/atomicfile"
+	"tailscale.com/util/cmpver"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// recordFile is the node record the package keeps beside tsnet's state once
+// the node has run (tailnet-attach design, decision 5): it says the state
+// directory held a signed-in node, so a state that went missing is reported,
+// never replaced by a new identity. tsnet would treat an empty state file as
+// missing and sign in as a new device.
+const recordFile = "node.pb"
+
+// checkState returns why a node must not start from dir, run by Tailscale
+// version tailscale, or nil when it may.
+func checkState(dir, tailscale string) error {
+	bytes, err := os.ReadFile(filepath.Join(dir, recordFile))
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("the tailnet node record cannot be read: %w", err)
+	}
+	record := new(pb.NodeRecord)
+	if err := proto.Unmarshal(bytes, record); err != nil {
+		return fmt.Errorf("the tailnet node record is corrupt: %w", err)
+	}
+	state, err := os.Stat(filepath.Join(dir, stateFile))
+	if errors.Is(err, fs.ErrNotExist) || (err == nil && state.Size() == 0) {
+		return fmt.Errorf("the tailnet state is gone: %s was signed in here; a new identity signs in as a new device", record.GetName())
+	}
+	if err != nil {
+		return fmt.Errorf("the tailnet state cannot be read: %w", err)
+	}
+	// tsnet has no downgrade path for its state.
+	if cmpver.Compare(record.GetTailscaleVersion(), tailscale) > 0 {
+		return fmt.Errorf("the tailnet state was written by Tailscale %s, newer than this build's %s", record.GetTailscaleVersion(), tailscale)
+	}
+	return nil
+}
+
+// ownsFile reports whether name, in a state directory, is the package's:
+// tsnet's state and logs, its certificates, and the node record. The core's
+// own files there stay where they are.
+func ownsFile(name string) bool {
+	return name == recordFile || name == "certs" || strings.HasPrefix(name, "tailscaled")
+}
+
+// setIdentityAside moves the package's files in dir into a replaced-<time>
+// directory beside them, so the next start signs in as a new device and the
+// old identity stays on disk.
+func setIdentityAside(dir string, now time.Time) error {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return fmt.Errorf("the tailnet state cannot be listed: %w", err)
+	}
+	aside := filepath.Join(dir, "replaced-"+now.UTC().Format("20060102T150405.000000000Z"))
+	made := false
+	for _, entry := range entries {
+		if !ownsFile(entry.Name()) {
+			continue
+		}
+		if !made {
+			if err := os.Mkdir(aside, 0o700); err != nil {
+				return fmt.Errorf("the old tailnet identity cannot be set aside: %w", err)
+			}
+			made = true
+		}
+		if err := os.Rename(filepath.Join(dir, entry.Name()), filepath.Join(aside, entry.Name())); err != nil {
+			return fmt.Errorf("the old tailnet identity cannot be set aside: %w", err)
+		}
+	}
+	return nil
+}
+
+// writeRecord stores record in dir, mode 0600, through a file renamed into
+// place, so a crash leaves the old record or the new one.
+func writeRecord(dir string, record *pb.NodeRecord) error {
+	bytes, err := proto.Marshal(record)
+	if err != nil {
+		return err
+	}
+	return atomicfile.WriteFile(filepath.Join(dir, recordFile), bytes, 0o600)
+}
diff --git a/shephrd/tailnet/identity_test.go b/shephrd/tailnet/identity_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..db908bd7723113dd3845e7b20df7249dbe2ccc52
--- /dev/null
+++ b/shephrd/tailnet/identity_test.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// recorded returns a state directory whose node ran under Tailscale ran,
+// with its state file holding state.
+func recorded(t *testing.T, ran string, state []byte) string {
+	t.Helper()
+	dir := t.TempDir()
+	record := &pb.NodeRecord{StableId: "nNODE", Name: "core.example.ts.net.", TailscaleVersion: ran}
+	if err := writeRecord(dir, record); err != nil {
+		t.Fatal(err)
+	}
+	if state != nil {
+		if err := os.WriteFile(filepath.Join(dir, stateFile), state, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+// TestAStateThatOutlivedItsRecordIsRefused checks the guard decision 5 asks
+// for: a node record whose state went missing, emptied or came from a newer
+// Tailscale stops the node, where tsnet would sign in as a new device or
+// misread the state.
+func TestAStateThatOutlivedItsRecordIsRefused(t *testing.T) {
+	for _, test := range []struct {
+		name  string
+		dir   string
+		wants string
+	}{
+		{"no record", t.TempDir(), ""},
+		{"a signed-in state", recorded(t, "1.104.1", []byte(`{"_machinekey":"x"}`)), ""},
+		{"an older Tailscale's state", recorded(t, "1.98.0", []byte(`{}`)), ""},
+		{"a deleted state", recorded(t, "1.104.1", nil), "the tailnet state is gone"},
+		{"an emptied state", recorded(t, "1.104.1", []byte{}), "the tailnet state is gone"},
+		{"a newer Tailscale's state", recorded(t, "1.106.0", []byte(`{}`)), "newer than this build's 1.104.1"},
+	} {
+		err := checkState(test.dir, "1.104.1")
+		switch {
+		case test.wants == "" && err != nil:
+			t.Errorf("%s: %v", test.name, err)
+		case test.wants != "" && (err == nil || !strings.Contains(err.Error(), test.wants)):
+			t.Errorf("%s: got %v, want an error with %q", test.name, err, test.wants)
+		}
+	}
+	corrupt := t.TempDir()
+	if err := os.WriteFile(filepath.Join(corrupt, recordFile), []byte{0xff, 0xff}, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := checkState(corrupt, "1.104.1"); err == nil || !strings.Contains(err.Error(), "corrupt") {
+		t.Errorf("a corrupt record: got %v", err)
+	}
+}
+
+// TestANewIdentitySetsOnlyThePackagesFilesAside checks that a new identity
+// moves tsnet's state and the record aside, keeps the core's files, and
+// leaves a directory a fresh node starts from.
+func TestANewIdentitySetsOnlyThePackagesFilesAside(t *testing.T) {
+	dir := recorded(t, "1.104.1", []byte(`{}`))
+	if err := os.WriteFile(filepath.Join(dir, "up.binpb"), []byte("core"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := setIdentityAside(dir, time.Date(2026, 11, 4, 12, 0, 0, 0, time.UTC)); err != nil {
+		t.Fatal(err)
+	}
+	aside := filepath.Join(dir, "replaced-20261104T120000.000000000Z")
+	for _, name := range []string{stateFile, recordFile} {
+		if _, err := os.Stat(filepath.Join(aside, name)); err != nil {
+			t.Errorf("%s is not set aside: %v", name, err)
+		}
+		if _, err := os.Stat(filepath.Join(dir, name)); !os.IsNotExist(err) {
+			t.Errorf("%s is still in place: %v", name, err)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(dir, "up.binpb")); err != nil {
+		t.Errorf("the core's file moved: %v", err)
+	}
+	if err := checkState(dir, "1.104.1"); err != nil {
+		t.Errorf("a fresh node is refused: %v", err)
+	}
+	info, err := os.Stat(filepath.Join(aside, recordFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if mode := info.Mode().Perm(); mode != 0o600 {
+		t.Errorf("the record is mode %o, want 600", mode)
+	}
+}
diff --git a/shephrd/tailnet/node.go b/shephrd/tailnet/node.go
new file mode 100644
index 0000000000000000000000000000000000000000..5d02007ab1cea68d17d753a2e5144d70ce500ecd
--- /dev/null
+++ b/shephrd/tailnet/node.go
@@ -0,0 +1,545 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"tailscale.com/client/local"
+	"tailscale.com/control/controlclient"
+	"tailscale.com/ipn"
+	"tailscale.com/tailcfg"
+	"tailscale.com/tsnet"
+	"tailscale.com/version"
+
+	pb "tailscale.com/shephrd/tailnet/tailnetpb"
+)
+
+// stateFile is where tsnet keeps the node's identity in its state directory.
+const stateFile = "tailscaled.state"
+
+// node is the one tsnet node of the process (tailnet-attach design, decision
+// 2): two nodes in one process misroute each other's segments.
+//
+// One goroutine, run's, owns the node's state and handles commands in order.
+// Work that waits, on the control server or the IPN bus, runs on goroutines of
+// its own and hands its result back to run through later, tagged with the
+// generation it began in; a result from an earlier node is dropped, so it never
+// touches a node started after it.
+type node struct {
+	core *core
+
+	// later carries results back to run; done closes when run returns.
+	later chan func()
+	done  chan struct{}
+
+	// Owned by run's goroutine.
+	server   *tsnet.Server
+	client   *local.Client
+	stateDir string
+	cancel   context.CancelFunc
+	// gen rises with each node started and each stopped; live mirrors it for
+	// the exit hook, which runs on a goroutine of tsnet's.
+	gen  uint64
+	live atomic.Uint64
+	// last is the latest state event, which a repeated up sends again.
+	last *pb.Event
+
+	// ids numbers the connections the node accepts, from 1, so no caller's
+	// id has [dialBit] set.
+	ids atomic.Uint64
+
+	// stable maps each node id the package has seen to its stable id, so a
+	// removed peer can be named.
+	stableMu sync.Mutex
+	stable   map[tailcfg.NodeID]tailcfg.StableNodeID
+}
+
+func newNode(c *core) *node {
+	n := &node{
+		core:   c,
+		later:  make(chan func()),
+		done:   make(chan struct{}),
+		stable: map[tailcfg.NodeID]tailcfg.StableNodeID{},
+	}
+	// A control-ordered Debug.Exit stops the node, not the process (design,
+	// decision 11). The hook runs on the map session's goroutine, which
+	// stopping the node waits for, so it only hands the stop to run.
+	controlclient.ExitHook = func(code int) {
+		// The node generation at the moment of the hook: a down and an up that
+		// run before the stop is carried out leave the new node alone.
+		gen := n.live.Load()
+		go n.handFor(gen, func() {
+			if n.stop() {
+				n.report(stateEvent(pb.NodeState_NODE_STATE_FAILED, "", fmt.Sprintf("the control server stopped this node (code %d)", code)))
+			}
+		})
+	}
+	return n
+}
+
+// run carries out commands and hands-back until commands closes, then stops
+// the node.
+func (n *node) run(commands <-chan *pb.Command) {
+	defer close(n.done)
+	defer n.stop()
+	for {
+		select {
+		case command, ok := <-commands:
+			if !ok {
+				return
+			}
+			n.carryOut(command)
+		case f := <-n.later:
+			f()
+		}
+	}
+}
+
+// hand runs f on run's goroutine, unless run has returned.
+func (n *node) hand(f func()) {
+	select {
+	case n.later <- f:
+	case <-n.done:
+	}
+}
+
+// handFor runs f on run's goroutine if the node is still generation gen.
+func (n *node) handFor(gen uint64, f func()) {
+	n.hand(func() {
+		if n.gen == gen {
+			f()
+		}
+	})
+}
+
+func (n *node) carryOut(command *pb.Command) {
+	switch body := command.GetBody().(type) {
+	case *pb.Command_Up:
+		n.up(body.Up)
+	case *pb.Command_Down:
+		n.stop()
+		n.report(stateEvent(pb.NodeState_NODE_STATE_STOPPED, "", ""))
+	case *pb.Command_Login:
+		n.login()
+	case *pb.Command_Logout:
+		n.logout()
+	case *pb.Command_Dial:
+		n.dial(body.Dial)
+	case *pb.Command_Taken:
+		n.core.taken(body.Taken.GetId())
+	case *pb.Command_ReadStats:
+		// Both counts stay far below 2^32.
+		n.core.send(&pb.Event{Body: &pb.Event_Stats{Stats: &pb.Stats{
+			Goroutines:  uint32(runtime.NumGoroutine()),
+			Connections: uint32(pumping.Load()),
+		}}})
+	}
+}
+
+func (n *node) up(up *pb.Up) {
+	// Up on a running node changes nothing and answers ready again, then the
+	// latest state, which says whether it runs or waits for a sign-in; a new
+	// port or hostname takes a down first. A new identity stops it first.
+	if n.server != nil && !up.GetNewIdentity() {
+		n.core.send(&pb.Event{Body: &pb.Event_Ready{Ready: &pb.Ready{}}})
+		if n.last != nil {
+			n.core.send(n.last)
+		}
+		return
+	}
+	n.stop()
+	// The state is checked before tsnet reads it: tsnet would sign in as a
+	// new device in place of a state that went missing (design, decision 5).
+	refused := func(err error) {
+		n.report(stateEvent(pb.NodeState_NODE_STATE_FAILED, "", err.Error()))
+	}
+	if up.GetNewIdentity() {
+		if err := setIdentityAside(up.GetStateDir(), time.Now()); err != nil {
+			refused(err)
+			return
+		}
+	}
+	if err := checkState(up.GetStateDir(), version.Short()); err != nil {
+		refused(err)
+		return
+	}
+	// No log upload and no socket-statistics log: the archive is built with
+	// ts_omit_logtail, so neither exists, and the package never sets an
+	// environment variable, which cgo would race against the core's threads
+	// (design, decision 5).
+	server := &tsnet.Server{
+		Dir:        up.GetStateDir(),
+		Hostname:   up.GetHostname(),
+		AuthKey:    up.GetAuthKey(),
+		ControlURL: up.GetControlUrl(),
+		Logf:       logf("tailnet"),
+		UserLogf:   logf("tailnet"),
+	}
+	// The generation is the new node's before tsnet starts, so an exit the
+	// control server orders during start-up or sign-in reaches it.
+	n.gen++
+	n.live.Store(n.gen)
+	failed := func(err error) {
+		server.Close()
+		n.report(stateEvent(pb.NodeState_NODE_STATE_FAILED, "", err.Error()))
+	}
+	if err := server.Start(); err != nil {
+		failed(err)
+		return
+	}
+	client, err := server.LocalClient()
+	if err != nil {
+		failed(err)
+		return
+	}
+	listener, err := server.Listen("tcp", ":"+strconv.FormatUint(uint64(up.GetPort()), 10))
+	if err != nil {
+		failed(err)
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	n.server, n.client, n.stateDir, n.cancel, n.last = server, client, up.GetStateDir(), cancel, nil
+	go n.watch(ctx, n.gen, server, client)
+	go n.accept(ctx, listener, client)
+	n.core.send(&pb.Event{Body: &pb.Event_Ready{Ready: &pb.Ready{}}})
+}
+
+// stop stops the node, if one runs, waits for tsnet to close, and reports
+// whether one ran. Results of work begun on it are dropped from then on.
+func (n *node) stop() bool {
+	if n.server == nil {
+		return false
+	}
+	n.cancel()
+	n.server.Close()
+	n.server, n.client, n.cancel, n.last = nil, nil, nil, nil
+	n.gen++
+	n.live.Store(n.gen)
+	return true
+}
+
+func (n *node) login() {
+	client, gen := n.client, n.gen
+	if client == nil {
+		return
+	}
+	// The control server answers when it will; the loop keeps carrying out
+	// commands meanwhile.
+	go func() {
+		if err := client.StartLoginInteractive(context.Background()); err != nil {
+			n.handFor(gen, func() {
+				n.report(stateEvent(pb.NodeState_NODE_STATE_NEEDS_LOGIN, "", err.Error()))
+			})
+		}
+	}()
+}
+
+// logout signs the node out at the control server, then stops it and deletes
+// its identity, so the next up signs in as a new device. A logout whose node
+// stopped or changed before the control server answered leaves the state on
+// disk alone.
+func (n *node) logout() {
+	client, dir, gen := n.client, n.stateDir, n.gen
+	if client == nil {
+		return
+	}
+	go func() {
+		logoutErr := client.Logout(context.Background())
+		n.hand(func() {
+			if n.gen != gen {
+				if logoutErr != nil {
+					n.core.send(stateEvent(pb.NodeState_NODE_STATE_STOPPED, "", logoutErr.Error()))
+				}
+				return
+			}
+			n.stop()
+			// The record goes with the state: the next up signs in afresh.
+			var removeErr error
+			for _, name := range []string{stateFile, recordFile} {
+				if err := os.Remove(filepath.Join(dir, name)); err != nil && !errors.Is(err, os.ErrNotExist) {
+					removeErr = errors.Join(removeErr, err)
+				}
+			}
+			problem := ""
+			if err := errors.Join(logoutErr, removeErr); err != nil {
+				problem = err.Error()
+			}
+			n.report(stateEvent(pb.NodeState_NODE_STATE_STOPPED, "", problem))
+		})
+	}()
+}
+
+// dialBit marks a dial's id, so its descriptor and a caller's share the
+// connections socket; callers are numbered from 1 and never reach it.
+const dialBit = uint64(1) << 63
+
+func (n *node) dial(dial *pb.Dial) {
+	server := n.server
+	failed := func(err error) {
+		n.core.send(&pb.Event{Body: &pb.Event_DialFailed{DialFailed: &pb.DialFailed{Id: dial.GetId(), Error: err.Error()}}})
+	}
+	if dial.GetId()&dialBit == 0 {
+		failed(errors.New("a dial's id must have the top bit set"))
+		return
+	}
+	if server == nil {
+		failed(errors.New("the tailnet node is not running"))
+		return
+	}
+	// A dial ends with its own event and descriptor, and touches no node
+	// state, so it runs on its own; on a node stopped meanwhile it fails.
+	go func() {
+		address := net.JoinHostPort(dial.GetHost(), strconv.FormatUint(uint64(dial.GetPort()), 10))
+		conn, err := server.Dial(context.Background(), "tcp", address)
+		if err != nil {
+			failed(err)
+			return
+		}
+		remote, err := netip.ParseAddrPort(conn.RemoteAddr().String())
+		if err != nil {
+			conn.Close()
+			failed(err)
+			return
+		}
+		fd, err := pump(conn)
+		if err != nil {
+			conn.Close()
+			failed(err)
+			return
+		}
+		// The descriptor goes first, so it waits on the socket when the core
+		// reads the event.
+		if err := n.core.sendFd(dial.GetId(), fd); err != nil {
+			failed(err)
+			return
+		}
+		n.core.send(&pb.Event{Body: &pb.Event_Dialed{Dialed: &pb.Dialed{Id: dial.GetId(), Address: remote.Addr().String()}}})
+	}()
+}
+
+// accept hands each caller to the core with its WhoIs identity. A caller
+// WhoIs cannot name arrives without a peer, and the core refuses it.
+func (n *node) accept(ctx context.Context, listener net.Listener, client *local.Client) {
+	defer listener.Close()
+	go func() {
+		<-ctx.Done()
+		listener.Close()
+	}()
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		go n.handOver(ctx, conn, client)
+	}
+}
+
+func (n *node) handOver(ctx context.Context, conn net.Conn, client *local.Client) {
+	id := n.ids.Add(1)
+	caller := &pb.Caller{Id: id}
+	if who, err := client.WhoIs(ctx, conn.RemoteAddr().String()); err == nil && who.Node != nil && who.UserProfile != nil {
+		n.remember(who.Node.ID, who.Node.StableID)
+		caller.Peer = &pb.Peer{
+			StableId:  string(who.Node.StableID),
+			NodeName:  who.Node.Name,
+			UserId:    uint64(who.UserProfile.ID),
+			LoginName: who.UserProfile.LoginName,
+			Tags:      who.Node.Tags,
+			Shared:    who.Node.Sharer != 0,
+		}
+	}
+	fd, err := pump(conn)
+	if err != nil {
+		// As at the open-file limit: the caller sees its connection close.
+		fmt.Fprintf(os.Stderr, "tailnet: connection %d not carried: %v\n", id, err)
+		conn.Close()
+		return
+	}
+	if err := n.core.sendFd(id, fd); err != nil {
+		fmt.Fprintf(os.Stderr, "tailnet: connection %d not handed over: %v\n", id, err)
+		return
+	}
+	n.core.send(&pb.Event{Body: &pb.Event_Caller{Caller: caller}})
+}
+
+func (n *node) remember(id tailcfg.NodeID, stable tailcfg.StableNodeID) {
+	n.stableMu.Lock()
+	defer n.stableMu.Unlock()
+	n.stable[id] = stable
+}
+
+// watch reads the node's state, sign-in link and peer changes from the IPN
+// bus until ctx ends, and hands each to run as generation gen's.
+func (n *node) watch(ctx context.Context, gen uint64, server *tsnet.Server, client *local.Client) {
+	watcher, err := client.WatchIPNBus(ctx, ipn.NotifyInitialState|ipn.NotifyPeerChanges|ipn.NotifyInitialHealthState)
+	if err != nil {
+		if ctx.Err() == nil {
+			n.handFor(gen, func() {
+				n.stop()
+				n.report(stateEvent(pb.NodeState_NODE_STATE_FAILED, "", err.Error()))
+			})
+		}
+		return
+	}
+	defer watcher.Close()
+	report := func(event *pb.Event) {
+		n.handFor(gen, func() { n.report(event) })
+	}
+	// Every state event carries the sign-in link while the node waits for
+	// one, and tsnet's health warnings, so a later event does not drop
+	// either: tsnet tells why a sign-in cannot start, such as a control
+	// server it cannot reach, only through its health.
+	current := ipn.NoState
+	var signIn signIns
+	link, warnings := "", ""
+	for {
+		notify, err := watcher.Next()
+		if err != nil {
+			return
+		}
+		if notify.Health != nil {
+			warnings = healthText(notify.Health)
+			if notify.State == nil {
+				n.readState(ctx, server, client, current, link, warnings, report)
+			}
+		}
+		if notify.State != nil {
+			current = *notify.State
+			if current != ipn.NeedsLogin {
+				link = ""
+			}
+			n.readState(ctx, server, client, current, link, warnings, report)
+			if signIn.again(current) {
+				if err := client.StartLoginInteractive(ctx); err != nil && ctx.Err() == nil {
+					report(stateEvent(pb.NodeState_NODE_STATE_NEEDS_LOGIN, link, err.Error()))
+				}
+			}
+		}
+		if notify.BrowseToURL != nil && *notify.BrowseToURL != "" {
+			link = *notify.BrowseToURL
+			report(stateEvent(pb.NodeState_NODE_STATE_NEEDS_LOGIN, link, warnings))
+		}
+		if notify.ErrMessage != nil {
+			n.readState(ctx, server, client, current, link, *notify.ErrMessage, report)
+		}
+		if peers := n.peers(notify); len(peers) > 0 {
+			event := &pb.Event{Body: &pb.Event_PeersChanged{PeersChanged: &pb.PeersChanged{Peers: peers}}}
+			n.handFor(gen, func() { n.core.send(event) })
+		}
+	}
+}
+
+// signIns decides when a node needs a new sign-in link. tsnet asks for one
+// at start, so the package asks again only when a node that ran needs a
+// sign-in, which means its key expired (design, decision 5). Asking at start
+// as well would make tsnet register a second node key, which the control
+// server would take for another device.
+type signIns struct {
+	// ran is whether the node has run since its last sign-in.
+	ran bool
+}
+
+// again reports whether the node, now in state, needs a new sign-in link.
+func (s *signIns) again(state ipn.State) bool {
+	switch state {
+	case ipn.Running:
+		s.ran = true
+	case ipn.NeedsLogin:
+		again := s.ran
+		s.ran = false
+		return again
+	}
+	return false
+}
+
+// readState turns an IPN state into a state event for report, reading the
+// running node's name and addresses first.
+func (n *node) readState(ctx context.Context, server *tsnet.Server, client *local.Client, state ipn.State, link, problem string, report func(*pb.Event)) {
+	switch state {
+	case ipn.Running:
+		event := stateEvent(pb.NodeState_NODE_STATE_RUNNING, "", problem)
+		if status, err := client.StatusWithoutPeers(ctx); err == nil && status.Self != nil {
+			event.GetState().Name = status.Self.DNSName
+			// The record says this directory now holds a signed-in node.
+			record := &pb.NodeRecord{
+				StableId:         string(status.Self.ID),
+				Name:             status.Self.DNSName,
+				TailscaleVersion: version.Short(),
+			}
+			if err := writeRecord(server.Dir, record); err != nil {
+				event.GetState().Error = fmt.Sprintf("the tailnet node record cannot be written: %v", err)
+			}
+		}
+		ip4, ip6 := server.TailscaleIPs()
+		for _, ip := range []string{ip4.String(), ip6.String()} {
+			if ip != "invalid IP" {
+				event.GetState().Addresses = append(event.GetState().Addresses, ip)
+			}
+		}
+		report(event)
+	case ipn.NeedsLogin:
+		report(stateEvent(pb.NodeState_NODE_STATE_NEEDS_LOGIN, link, problem))
+	case ipn.Stopped:
+		report(stateEvent(pb.NodeState_NODE_STATE_STOPPED, "", problem))
+	default:
+		report(stateEvent(pb.NodeState_NODE_STATE_STARTING, "", problem))
+	}
+}
+
+// peers is each peer the notification changed or removed.
+func (n *node) peers(notify ipn.Notify) []*pb.Peer {
+	var peers []*pb.Peer
+	for _, changed := range notify.PeersChanged {
+		n.remember(changed.ID, changed.StableID)
+		peers = append(peers, &pb.Peer{
+			StableId: string(changed.StableID),
+			NodeName: changed.Name,
+			UserId:   uint64(changed.User),
+			Tags:     changed.Tags,
+			Shared:   changed.Sharer != 0,
+		})
+	}
+	n.stableMu.Lock()
+	defer n.stableMu.Unlock()
+	for _, id := range notify.PeersRemoved {
+		stable, ok := n.stable[id]
+		if !ok {
+			continue
+		}
+		delete(n.stable, id)
+		peers = append(peers, &pb.Peer{StableId: string(stable), Removed: true})
+	}
+	return peers
+}
+
+// report sends a state event and keeps it as the node's latest; it runs on
+// run's goroutine.
+func (n *node) report(event *pb.Event) {
+	n.last = event
+	n.core.send(event)
+}
+
+func stateEvent(state pb.NodeState, loginURL, problem string) *pb.Event {
+	return &pb.Event{Body: &pb.Event_State{State: &pb.State{State: state, LoginUrl: loginURL, Error: problem}}}
+}
+
+// logf prints tsnet's log to stderr, which shephrdd writes to core.log, when
+// SHEPHRD_TAILNET_LOG is set; otherwise it drops it.
+func logf(prefix string) func(string, ...any) {
+	if os.Getenv("SHEPHRD_TAILNET_LOG") == "" {
+		return func(string, ...any) {}
+	}
+	return func(format string, args ...any) {
+		fmt.Fprintf(os.Stderr, "%s: %s\n", prefix, fmt.Sprintf(format, args...))
+	}
+}
diff --git a/shephrd/tailnet/node_test.go b/shephrd/tailnet/node_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ba06d38645ad9d41c0f9b449597c0d1fdacb6696
--- /dev/null
+++ b/shephrd/tailnet/node_test.go
@@ -0,0 +1,35 @@
+package main
+
+import (
+	"testing"
+
+	"tailscale.com/ipn"
+)
+
+// TestASignInIsAskedForOnlyAfterTheNodeRan walks the states a node passes
+// through: the sign-in tsnet asks for at start is not asked for again, and a
+// node that ran and then needs a sign-in, as when its key expires, gets a new
+// link once.
+func TestASignInIsAskedForOnlyAfterTheNodeRan(t *testing.T) {
+	steps := []struct {
+		state ipn.State
+		again bool
+	}{
+		{ipn.NoState, false},
+		{ipn.NeedsLogin, false},
+		{ipn.Starting, false},
+		{ipn.Running, false},
+		{ipn.NeedsLogin, true},
+		{ipn.NeedsLogin, false},
+		{ipn.Starting, false},
+		{ipn.Running, false},
+		{ipn.Stopped, false},
+		{ipn.NeedsLogin, true},
+	}
+	var signIn signIns
+	for i, step := range steps {
+		if got := signIn.again(step.state); got != step.again {
+			t.Errorf("step %d, %v: again = %v, want %v", i, step.state, got, step.again)
+		}
+	}
+}
