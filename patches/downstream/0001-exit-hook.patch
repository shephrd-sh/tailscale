exit-hook

From: Victor Araújo <victor@victor-software-house.com>

Downstream-Reason: Let an embedder handle a control-ordered Debug.Exit: controlclient.ExitHook, when set, is called instead of os.Exit, so shephrd stops its tsnet node and keeps its process, its local socket and its panes.
Upstream-Status: not-submitted
Drop-When: Upstream tsnet or controlclient offers an embedder exit handler that replaces os.Exit on Debug.Exit.
---
 control/controlclient/direct.go      |   16 ++++++++++++++++
 control/controlclient/direct_test.go |   16 ++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/control/controlclient/direct.go b/control/controlclient/direct.go
index 2ce9cba2e5443232daceece637a955d1995abb10..8520d450b3cfb42b13dd3e72ea319b78ae5256b2 100644
--- a/control/controlclient/direct.go
+++ b/control/controlclient/direct.go
@@ -1395,8 +1395,24 @@ func NetmapFromMapResponseForDebug(ctx context.Context, pr persist.PersistView,
 	return sess.netmap(), nil
 }
 
+// ExitHook, when non-nil, is called instead of os.Exit when a map response
+// carries tailcfg.Debug.Exit. A program that embeds a client and serves more
+// than the tailnet, such as one built on tsnet, sets it to stop the client
+// alone. It runs on the map session's goroutine, so it must not wait for the
+// client to stop. Set it before starting any client.
+var ExitHook func(code int)
+
+// errExitRequested ends the map response that carried tailcfg.Debug.Exit
+// when ExitHook handled it, so none of that response is applied.
+var errExitRequested = errors.New("control plane requested exit")
+
 func (c *Direct) handleDebugMessage(ctx context.Context, debug *tailcfg.Debug) error {
 	if code := debug.Exit; code != nil {
+		if hook := ExitHook; hook != nil {
+			c.logf("stopping with status %v per controlplane", *code)
+			hook(*code)
+			return errExitRequested
+		}
 		c.logf("exiting process with status %v per controlplane", *code)
 		os.Exit(*code)
 	}
diff --git a/control/controlclient/direct_test.go b/control/controlclient/direct_test.go
index 46fe2afcf0d583aa5c01db4682bf1e0edca492f9..560e12ca098ef7aaf74ab80a71b3d29dd3cdea61 100644
--- a/control/controlclient/direct_test.go
+++ b/control/controlclient/direct_test.go
@@ -367,3 +367,19 @@ func TestDecodeMsgMaxDecodedSize(t *testing.T) {
 		t.Fatalf("decodeMsg(oversized frame) = %v, want zstd.ErrDecoderSizeExceeded", err)
 	}
 }
+
+func TestHandleDebugMessageExitHook(t *testing.T) {
+	var got []int
+	ExitHook = func(code int) { got = append(got, code) }
+	defer func() { ExitHook = nil }()
+
+	c := &Direct{logf: t.Logf}
+	code := 3
+	err := c.handleDebugMessage(t.Context(), &tailcfg.Debug{Exit: &code})
+	if !errors.Is(err, errExitRequested) {
+		t.Fatalf("handleDebugMessage(Exit: 3) = %v, want errExitRequested", err)
+	}
+	if len(got) != 1 || got[0] != 3 {
+		t.Fatalf("ExitHook calls = %v, want [3]", got)
+	}
+}
